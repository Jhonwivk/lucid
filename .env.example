# Optional local overrides (none required for the basic local shell).
# LUCID_DATA_DIR=../data
# LUCID_DB_PATH=../data/lucid.db
# LUCID_API_HOST=127.0.0.1
# LUCID_API_PORT=8000

# Business Modeling Agent (required for LIVE product-runtime runs)
# LUCID_MODEL_NAME=
# LUCID_MODEL_BASE_URL=
# LUCID_MODEL_API_KEY=
# LUCID_MODEL_API_VERSION=
# LUCID_MODEL_TIMEOUT_SECONDS=120

# Azure Content Understanding (GA 2025-11-01). Required for complex files/images.
# AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
# AZURE_CONTENT_UNDERSTANDING_KEY=
# AZURE_CONTENT_UNDERSTANDING_ANALYZER_ID=prebuilt-document
# AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-11-01

# Materials intake does not require a vision provider or API key.
# Cursor development credentials are not backend model access.

